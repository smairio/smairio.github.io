---
import { Icon } from 'astro-icon/components';

import { getHomePermalink } from '~/utils/permalinks';

/**
 * The shutter: the shop's painted green rideau closes the page. The phone
 * number is lettered big — Tunisian storefronts paint their number at sign
 * scale, and it is also this site's whole conversion path.
 */
interface Link {
  text?: string;
  href?: string;
  ariaLabel?: string;
  icon?: string;
  target?: string;
}

interface Links {
  title?: string;
  links: Array<Link>;
}

export interface Props {
  links: Array<Links>;
  secondaryLinks: Array<Link>;
  socialLinks: Array<Link>;
  footNote?: string;
  bigContact?: { label: string; href: string; note?: string };
}

const { links = [], socialLinks = [], footNote = '', bigContact } = Astro.props;
---

<footer class="panneau grain relative not-prose">
  <div class="relative max-w-6xl mx-auto px-5 sm:px-8 py-12 md:py-16">
    {
      bigContact && (
        <div class="text-center pb-10 mb-10 border-b-2 border-on-green/40">
          <a
            href={bigContact.href}
            class="font-heading uppercase text-plaster text-[clamp(1.8rem,6.5vw,3.5rem)] tracking-wide leading-none hover:text-accent transition-colors duration-200 [text-shadow:0.05em_0.05em_0_var(--paint-ink)]"
          >
            {bigContact.label}
          </a>
          {bigContact.note && <p class="mt-3 text-on-green text-sm">{bigContact.note}</p>}
        </div>
      )
    }

    <div class="grid grid-cols-12 gap-6 gap-y-9">
      <div class="col-span-12 md:col-span-4">
        <a class="inline-block font-heading uppercase text-2xl text-plaster" href={getHomePermalink()}>
          Lamda<span class="text-accent">Soft</span>
        </a>
        <p class="mt-3 text-on-green text-sm max-w-[38ch]">
          Agence digitale tunisienne. Ce site est notre propre vitrine — nous l'avons construit comme nous construirons
          la vôtre.
        </p>
      </div>
      {
        links.map(({ title, links: groupLinks }) => (
          <div class="col-span-6 md:col-span-4">
            <p class="font-heading uppercase text-sm tracking-[0.12em] text-accent mb-3">{title}</p>
            {groupLinks && groupLinks.length > 0 && (
              <ul class="space-y-2 text-sm">
                {groupLinks.map(({ text, href, ariaLabel, target }) => (
                  <li>
                    <a
                      class="text-plaster/90 hover:text-accent transition-colors duration-150"
                      href={href}
                      aria-label={ariaLabel}
                      {...(target ? { target, rel: 'noopener noreferrer' } : {})}
                    >
                      {text}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </div>
        ))
      }
    </div>

    <div class="mt-10 pt-6 border-t-2 border-on-green/40 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-on-green text-sm" set:html={footNote} />
      {
        socialLinks?.length ? (
          <ul class="flex gap-2">
            {socialLinks.map(({ ariaLabel, href, icon }) => (
              <li>
                <a
                  class="text-on-green hover:text-accent p-2 inline-flex items-center transition-colors duration-150"
                  aria-label={ariaLabel}
                  href={href}
                >
                  {icon && <Icon name={icon} class="w-5 h-5" />}
                </a>
              </li>
            ))}
          </ul>
        ) : null
      }
    </div>
  </div>
</footer>
