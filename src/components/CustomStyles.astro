---
// The two sign-painting faces of « la devanture peinte » (see DESIGN.md).
// Archivo Black letters the signs; Archivo Variable does the talking.
// Subsets ship with unicode-range, so French (incl. œ) costs two woff2 files.
import '@fontsource/archivo-black';
import '@fontsource-variable/archivo/wght.css';
---

<style is:inline>
  :root {
    --aw-font-sans: 'Archivo Variable', system-ui, sans-serif;
    --aw-font-serif: 'Archivo Variable', system-ui, sans-serif;
    --aw-font-heading: 'Archivo Black', 'Archivo Variable', system-ui, sans-serif;

    /* Enamel sign paints — roles documented in DESIGN.md. */
    --aw-color-primary: #0e4b38; /* enamel green: the carrying colour */
    --aw-color-secondary: #093726; /* deep green: hover/pressed */
    --aw-color-accent: #e9a820; /* ochre: price plates & CTA only */

    --paint-red: #b93a1d; /* signal red: sparse accents on plaster */
    --paint-plaster: #f4eee1; /* the wall */
    --paint-ink: #231f17;
    --paint-on-green: #d8e4dc; /* secondary text on green — tinted, never gray */

    --aw-color-text-heading: var(--paint-ink);
    --aw-color-text-default: var(--paint-ink);
    --aw-color-text-muted: color-mix(in oklab, var(--paint-ink) 68%, var(--paint-plaster));
    --aw-color-bg-page: var(--paint-plaster);

    --aw-color-bg-page-dark: var(--paint-plaster);

    /* One easing for the whole shop. */
    --paint-ease: cubic-bezier(0.22, 1, 0.36, 1);

    ::selection {
      background-color: var(--aw-color-accent);
      color: var(--paint-ink);
    }
  }
</style>
