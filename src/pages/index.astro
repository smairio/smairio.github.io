---
import Layout from '~/layouts/PageLayout.astro';

import CallToAction from '~/components/widgets/CallToAction.astro';
import DemoGallery from '~/components/widgets/DemoGallery.astro';
import Features from '~/components/widgets/Features.astro';
import Hero from '~/components/widgets/Hero.astro';
import ServicePillars from '~/components/widgets/ServicePillars.astro';
import Testimonials from '~/components/widgets/Testimonials.astro';

import { CONTACT, whatsappLink } from '~/contact';
import { demos } from '~/data/demos';

/** One WhatsApp opener per pillar, so an incoming message says which one it came from. */
const pillarCta = (subject: string) => ({
  variant: 'link' as const,
  text: 'En parler sur WhatsApp',
  href: whatsappLink(`Bonjour, je m'intéresse à : ${subject}.`),
  target: '_blank',
  icon: 'tabler:brand-whatsapp',
});

const metadata = {
  title: 'LamdaSoft — Digitalisez votre entreprise',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <Hero
    actions={[
      {
        variant: 'primary',
        text: 'Discuter sur WhatsApp',
        href: whatsappLink('Bonjour, je souhaite digitaliser mon entreprise.'),
        target: '_blank',
        icon: 'tabler:brand-whatsapp',
      },
      { text: 'Voir nos services', href: '#services' },
    ]}
  >
    <Fragment slot="title">Digitalisez votre entreprise</Fragment>

    <Fragment slot="subtitle">
      Vos rendez-vous sur un carnet, vos dossiers dans des classeurs, vos devis perdus dans WhatsApp. Nous remplaçons
      tout ça par des outils simples, faits pour votre activité.
    </Fragment>
  </Hero>

  <ServicePillars
    id="services"
    tagline="Services"
    title="Ce que nous construisons"
    subtitle="Quatre domaines. On commence par le plus urgent pour vous, et on étend ensuite."
    pillars={[
      {
        title: 'Sites web & applications mobiles',
        icon: 'tabler:devices',
        items: [
          'Site vitrine ou boutique en ligne, rapide et visible sur Google',
          'Application mobile Android et iPhone',
          'Prise de rendez-vous et réservation en ligne',
        ],
        price: 'À partir de 500 TND',
        callToAction: pillarCta('un site web ou une application mobile'),
      },
      {
        title: 'Outils de gestion sur mesure',
        icon: 'tabler:layout-dashboard',
        items: [
          'Tableau de bord : votre activité en un coup d’œil',
          'CRM : clients, devis et relances au même endroit',
          'ERP : stock, facturation et personnel',
        ],
        price: 'Sur devis',
        callToAction: pillarCta('un outil de gestion sur mesure'),
      },
      {
        title: 'Digitalisation & IA',
        icon: 'tabler:scan',
        items: [
          'Vos registres et dossiers papier deviennent des fichiers consultables',
          'Scan intelligent : une photo d’un document, les données en sortent',
          'Génération automatique de vos devis, contrats et factures',
        ],
        price: 'Sur devis',
        callToAction: pillarCta('la digitalisation de mes documents'),
      },
      {
        title: 'Cloud & hébergement',
        icon: 'tabler:cloud',
        items: [
          'Déploiement cloud, avec option d’hébergement de vos données en Tunisie',
          'Sauvegardes automatiques et restauration',
          'Mise en ligne, surveillance et mises à jour',
        ],
        price: 'Sur devis',
        callToAction: pillarCta('l’hébergement et le cloud'),
      },
    ]}
  />

  <DemoGallery
    id="realisations"
    tagline="Réalisations"
    title="Nos démonstrations"
    subtitle="Nous construisons ces projets pour montrer concrètement ce que nous savons faire. Ce sont des démonstrations, pas des projets clients : nous ne présenterons jamais le travail d’un autre comme le nôtre."
    demos={demos}
  />
  <Features
    id="confiance"
    tagline="Confiance"
    title="Le risque est de notre côté, pas du vôtre"
    subtitle="Nous démarrons, et c’est justement pour ça que nous donnons le maximum : votre projet sera notre vitrine. Voilà ce que nous garantissons par écrit."
    columns={2}
    items={[
      {
        title: 'Vous ne payez pas un travail qui ne vous convient pas',
        description: 'La moitié à la commande, la moitié à la livraison — et seulement si le résultat vous convient.',
        icon: 'tabler:shield-check',
      },
      {
        title: 'Un accord écrit avant de commencer',
        description:
          'Une page : ce qui est inclus, le prix, la date de livraison. Vous savez exactement ce que vous achetez.',
        icon: 'tabler:writing-sign',
      },
      {
        title: 'On commence petit',
        description: 'Un premier projet simple, livré vite et bien. Vous jugez sur pièce avant d’aller plus loin.',
        icon: 'tabler:stairs-up',
      },
      {
        title: 'On reste joignables',
        description: 'Sur WhatsApp, rapidement — pendant le projet comme après la livraison.',
        icon: 'tabler:message-circle',
      },
    ]}
  />

  <Testimonials
    title="Avis clients — à venir"
    subtitle="Nous venons de démarrer : cette section est vide. Les premiers avis seront publiés ici avec le nom de leurs auteurs et leur accord."
    testimonials={[]}
  />

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Discuter sur WhatsApp',
        href: whatsappLink('Bonjour, je souhaite digitaliser mon entreprise.'),
        target: '_blank',
        icon: 'tabler:brand-whatsapp',
      },
      {
        variant: 'tertiary',
        text: CONTACT.phoneDisplay,
        href: `tel:${CONTACT.phone}`,
        icon: 'tabler:phone',
      },
    ]}
  >
    <Fragment slot="title">Parlons de votre projet</Fragment>

    <Fragment slot="subtitle">
      Dites-nous ce qui vous prend le plus de temps aujourd’hui. Nous revenons vers vous avec une proposition concrète.
    </Fragment>
  </CallToAction>
</Layout>
