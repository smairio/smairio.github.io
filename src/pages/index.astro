---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';

import { whatsappLink } from '~/contact';

const metadata = {
  title: 'LamdaSoft — Digitalisez votre entreprise',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <Hero
    actions={[
      {
        variant: 'primary',
        text: 'Discuter sur WhatsApp',
        href: whatsappLink('Bonjour, je souhaite digitaliser mon entreprise.'),
        target: '_blank',
        icon: 'tabler:brand-whatsapp',
      },
      { text: 'Voir nos services', href: '#services' },
    ]}
  >
    <Fragment slot="title">Digitalisez votre entreprise</Fragment>

    <Fragment slot="subtitle">
      Vos rendez-vous sur un carnet, vos dossiers dans des classeurs, vos devis perdus dans WhatsApp. Nous remplaçons
      tout ça par des outils simples, faits pour votre activité.
    </Fragment>
  </Hero>

  <!-- TODO(#4): section services — les 4 piliers (id="services") -->
  <!-- TODO(#5): section réalisations — démonstrations (id="realisations") -->
  <!-- TODO(#6): section confiance — garanties (id="confiance") -->
</Layout>
