---
import Layout from '~/layouts/PageLayout.astro';
import { getHomePermalink } from '~/utils/permalinks';

const title = `Erreur 404`;
---

<Layout metadata={{ title }}>
  <section class="grain flex items-center min-h-[60vh] px-5">
    <div class="max-w-md mx-auto my-16 text-center">
      <p class="plaque px-4 py-2 -rotate-2 text-sm">Panneau introuvable</p>
      <h1 class="mt-8 font-heading text-primary text-8xl [text-shadow:4px_4px_0_var(--paint-ink)]">
        <span class="sr-only">Erreur</span>404
      </h1>
      <p class="mt-6 text-xl font-heading">Cette page n'existe pas.</p>
      <p class="mt-3 mb-8 text-muted">Le lien est peut-être erroné. Revenez à l'accueil pour retrouver nos services.</p>
      <a rel="noopener noreferrer" href={getHomePermalink()} class="btn-primary">Retour à l'accueil</a>
    </div>
  </section>
</Layout>
